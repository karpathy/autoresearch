{
  "source_root": "source",
  "state_dir": ".lab",
  "source_paths": ["rule.txt", "evaluator.py"],
  "editable_files": ["rule.txt"],
  "input_files": ["cases.json"],
  "evaluator": ["{python}", "evaluator.py", "{candidate}", "{run_dir}", "{config_dir}"],
  "metrics": {
    "primary": "mean_error",
    "direction": "min",
    "guards": [{"name": "coverage", "direction": "max"}]
  },
  "repeats": 2,
  "timeout_seconds": 5,
  "budget": {
    "max_seconds": 60,
    "max_trials": 5,
    "max_requests": 0,
    "max_cost_usd": 0
  }
}
